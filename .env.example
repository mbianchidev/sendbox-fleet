# Copy to `.env` and adjust. These are local development examples, not secrets.

# docker compose (see docs/development.md)
POSTGRES_DB=sendbox_fleet
POSTGRES_USER=sendbox_fleet
POSTGRES_PASSWORD=local-dev-only-change-me
FLEET_PORT=8080
FLEET_LOG_LEVEL=info
FLEET_LOG_RETENTION_DAYS=30
FLEET_AUTHORITY_ID=sendbox-fleet
# Path inside the container to the profile signer file; mount it with a
# compose override. Publication is refused while this is empty.
FLEET_PROFILE_TRUST=
# Path inside the container to the OIDC issuer file (docs/deployment.md).
# Empty: only service tokens from `sendbox-fleet admin token create` work.
FLEET_OIDC_CONFIG=
# Lifetime of tokens issued by POST /v1/tokens (default 12 h, max 7 d).
FLEET_TOKEN_TTL_SECONDS=43200
FLEET_TOKEN_MAX_TTL_SECONDS=604800
# Ed25519 key from `sendbox-fleet admin audit keygen` (file mode 0600).
FLEET_AUDIT_SIGNING_KEY=
# Directory for periodic signed audit heads; needs the signing key.
# Use /var/lib/sendbox-fleet/anchors to write to the compose volume.
FLEET_AUDIT_ANCHOR_DIR=
FLEET_AUDIT_ANCHOR_INTERVAL_SECONDS=3600
# Per-principal /v1 requests and per-peer failed sign-ins per minute (0 disables).
FLEET_RATE_LIMIT_PER_MINUTE=1200
FLEET_AUTH_FAILURES_PER_MINUTE=60
# Separate unauthenticated Prometheus listener, e.g. 0.0.0.0:9090. Empty disables.
FLEET_METRICS_BIND=
# false: refuse to start until `sendbox-fleet admin migrate` has run.
FLEET_MIGRATE=true
FLEET_LOG_MAX_BYTES=104857600

# Running the binary directly with SQLite (export these in your shell)
# FLEET_DATABASE_URL=sqlite://sendbox-fleet.db?mode=rwc
# FLEET_BIND=127.0.0.1:8080
# FLEET_LOG_DIR=./logs
# FLEET_AUTHORITY_ID=sendbox-fleet
# FLEET_PROFILE_TRUST=./profile-trust.yaml
