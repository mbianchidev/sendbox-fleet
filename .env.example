# Copy to `.env` and adjust. These are local development examples, not secrets.

# docker compose (see docs/development.md)
POSTGRES_DB=sendbox_fleet
POSTGRES_USER=sendbox_fleet
POSTGRES_PASSWORD=local-dev-only-change-me
FLEET_PORT=8080
FLEET_LOG_LEVEL=info
FLEET_LOG_RETENTION_DAYS=30

# Running the binary directly with SQLite (export these in your shell)
# FLEET_DATABASE_URL=sqlite://sendbox-fleet.db?mode=rwc
# FLEET_BIND=127.0.0.1:8080
# FLEET_LOG_DIR=./logs
